{
  "name": "asyncup",
  "version": "0.1.0",
  "description": "AsyncUp — open-source, self-hosted async daily standups for Google Chat (Slack and Teams planned).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "web:dev": "bun run --cwd web dev",
    "web:build": "bun run --cwd web build",
    "web:test": "bun run --cwd web test",
    "web:typecheck": "bun run --cwd web typecheck",
    "site:build": "bun scripts/build-site.ts"
  },
  "dependencies": {
    "@googleapis/chat": "^45.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@node-saml/node-saml": "^5.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^11.0.2",
    "luxon": "^3.7.2",
    "pg": "^8.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.1",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4"
  }
}
